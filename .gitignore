__pycache__/
*.pyc
.venv/

# The SQLite database is created by `flask init-db`, never committed.
# Ignore the instance folder's contents, not the folder itself, so the tracked
# .gitkeep below can survive the rule.
instance/*
!instance/.gitkeep
*.sqlite
*.sqlite3
*.db

# No credential belongs in this project (TCGdex needs no API key), but keep
# the ignore rule so one can never be committed by accident.
.env
